<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/learning_topic_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#FFFDF8">
 <LinearLayout android:id="@+id/learning_topic_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="24dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="72dp" android:paddingHorizontal="18dp" android:gravity="center_vertical" android:background="#FFFFFF">
   <TextView android:id="@+id/learning_topic_back" android:layout_width="52dp" android:layout_height="match_parent" android:gravity="center" android:text="←" android:textSize="29sp" android:textColor="#405270" />
   <TextView android:id="@+id/learning_topic_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="IB Mathematics" android:textColor="#0A142F" android:textSize="21sp" android:textStyle="bold" />
  </LinearLayout>
  <TextView android:id="@+id/learning_topic_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="28dp" android:layout_marginBottom="12dp" android:text="IB Mathematics" android:textColor="#5D7190" android:textSize="20sp" />
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="28dp" android:orientation="vertical" android:padding="32dp" android:background="@drawable/hero_card">
   <TextView android:id="@+id/learning_topic_eyebrow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="▤  IB MATHEMATICS" android:textColor="#F6D970" android:textSize="16sp" android:textStyle="bold" />
   <TextView android:id="@+id/learning_topic_heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="34dp" android:text="Understand&#10;deeply. Think&#10;clearly." android:textColor="#FFFFFF" android:textSize="45sp" android:textStyle="bold" android:lineSpacingExtra="2dp" />
   <TextView android:id="@+id/learning_topic_description" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="30dp" android:text="Build strong conceptual understanding through a structured IB pathway, guided practice, and purposeful revision." android:textColor="#D7E0EE" android:textSize="20sp" android:lineSpacingExtra="8dp" />
   <TextView android:id="@+id/learning_topic_button" android:layout_width="250dp" android:layout_height="64dp" android:layout_marginTop="32dp" android:gravity="center" android:text="Continue learning  →" android:textColor="#0A142F" android:textSize="18sp" android:textStyle="bold" android:background="@drawable/login_submit" />
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="28dp" android:padding="32dp" android:orientation="vertical" android:background="@drawable/login_card">
   <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="◎" android:textColor="#A67500" android:textSize="42sp" />
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="Your learning placement" android:textColor="#5D7190" android:textSize="19sp" android:textStyle="bold" />
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Grade 7" android:textColor="#0A142F" android:textSize="42sp" android:textStyle="bold" />
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Your current grade and revision pathway are ready to explore." android:textColor="#4F6486" android:textSize="19sp" android:lineSpacingExtra="5dp" />
  </LinearLayout>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="30dp" android:layout_marginTop="12dp" android:text="Choose your grade                         Registered grade: 7" android:textColor="#0A142F" android:textSize="29sp" android:textStyle="bold" />
  <LinearLayout android:id="@+id/grade_cards" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:orientation="vertical" android:padding="30dp" android:background="#FFFAEF">
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="About MathsNMe" android:textColor="#0A142F" android:textSize="27sp" android:textStyle="bold" />
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="MathsNMe helps students build confidence, calculation speed, and mathematical thinking through Vedic Maths, IB Maths, and structured problem-solving practice.&#10;&#10;Contact Us&#10;Email: rameshaol@gmail.com&#10;Contact: +91 7794998524" android:textColor="#4F6486" android:textSize="18sp" android:lineSpacingExtra="7dp" />
  </LinearLayout>
 </LinearLayout>
</ScrollView>
