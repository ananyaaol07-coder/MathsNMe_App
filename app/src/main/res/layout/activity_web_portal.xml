<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/web_portal_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#FFFDF8">
    <WebView android:id="@+id/web_portal_webview" android:layout_width="match_parent" android:layout_height="match_parent" />
    <ProgressBar android:id="@+id/web_portal_progress" android:layout_width="match_parent" android:layout_height="3dp" android:layout_gravity="top" android:indeterminate="true" />
    <LinearLayout android:id="@+id/web_portal_error" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="32dp" android:gravity="center" android:orientation="vertical" android:background="#FFFDF8" android:visibility="gone">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="Website is not running" android:textColor="#0F172A" android:textSize="24sp" android:textStyle="bold" />
        <TextView android:id="@+id/web_portal_error_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:gravity="center" android:textColor="#475569" android:textSize="16sp" />
    </LinearLayout>
</FrameLayout>
