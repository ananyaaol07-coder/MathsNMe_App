<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/register_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#FFFDF8">
    <LinearLayout android:layout_width="match_parent" android:layout_height="76dp" android:paddingHorizontal="20dp" android:gravity="center_vertical" android:background="#FFFFFF">
        <ImageView android:id="@+id/register_logo" android:layout_width="160dp" android:layout_height="52dp" android:minWidth="48dp" android:minHeight="48dp" android:src="@drawable/mathsnme_brand" android:scaleType="fitCenter" android:contentDescription="@string/app_name" android:clickable="true" android:focusable="true" />
        <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <TextView android:id="@+id/register_home" android:layout_width="wrap_content" android:layout_height="48dp" android:gravity="center" android:drawableStart="@drawable/login_back" android:drawablePadding="6dp" android:text="@string/login_home" android:contentDescription="@string/login_home" android:textSize="13sp" android:textStyle="bold" android:textColor="#475569" android:clickable="true" android:focusable="true" />
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F0E7CF" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:background="@drawable/landing_background">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="22dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="28dp" android:orientation="vertical" android:background="@drawable/register_hero" android:elevation="4dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/register_hero_label" android:textColor="#A47700" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.14" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="36dp" android:text="Your child." android:textColor="#020617" android:textSize="34sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Their maths." android:textColor="#020617" android:textSize="34sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Let’s talk." android:textColor="#B8860B" android:textSize="34sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:text="@string/register_hero_subtitle" android:textColor="#020617" android:textSize="18sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="@string/register_hero_body" android:textColor="#475569" android:textSize="16sp" android:lineSpacingExtra="5dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:orientation="horizontal">
                    <TextView android:layout_width="wrap_content" android:layout_height="48dp" android:gravity="center" android:paddingHorizontal="16dp" android:text="@string/register_zoom" android:textColor="#A47700" android:textSize="14sp" android:textStyle="bold" android:background="@drawable/login_badge" />
                    <TextView android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginStart="10dp" android:gravity="center" android:paddingHorizontal="16dp" android:text="@string/register_duration" android:textColor="#A47700" android:textSize="14sp" android:textStyle="bold" android:background="@drawable/login_badge" />
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="@string/register_bullet_1" android:textColor="#334155" android:textSize="14sp" android:lineSpacingExtra="8dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/register_bullet_2" android:textColor="#334155" android:textSize="14sp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/register_bullet_3" android:textColor="#334155" android:textSize="14sp" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="40dp" android:text="@string/register_intro_label" android:textColor="#B8860B" android:textSize="9sp" android:textStyle="bold" android:letterSpacing="0.12" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/register_intro_title" android:textColor="#020617" android:textSize="25sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/register_intro_body" android:textColor="#475569" android:textSize="13sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:padding="28dp" android:orientation="vertical" android:background="@drawable/login_card" android:elevation="4dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/register_parent_details" android:textColor="#0F172A" android:textSize="16sp" android:textStyle="bold" />
                <EditText android:id="@+id/register_parent_name" style="@style/RegisterField" android:hint="@string/register_parent_name" />
                <EditText android:id="@+id/register_parent_mobile" style="@style/RegisterField" android:hint="@string/register_mobile_hint" android:inputType="phone" />
                <EditText android:id="@+id/register_parent_email" style="@style/RegisterField" android:hint="@string/register_parent_email" android:inputType="textEmailAddress" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="@string/register_student_details" android:textColor="#0F172A" android:textSize="16sp" android:textStyle="bold" />
                <EditText android:id="@+id/register_student_name" style="@style/RegisterField" android:hint="@string/register_student_name" />
                <EditText android:id="@+id/register_student_mobile" style="@style/RegisterField" android:hint="@string/register_student_mobile" />
                <TextView android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:text="@string/register_same_phone" android:textColor="#475569" android:textSize="13sp" android:drawableStart="@drawable/login_check" android:drawablePadding="8dp" />
                <TextView android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center_vertical" android:paddingHorizontal="12dp" android:text="@string/register_using_parent_email" android:textColor="#AAB7C8" android:textSize="13sp" android:background="#F1F5F9" />
                <TextView android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:text="@string/register_same_email" android:textColor="#475569" android:textSize="13sp" android:drawableStart="@drawable/login_check" android:drawablePadding="8dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/register_grade" android:textColor="#334155" android:textSize="12sp" android:textStyle="bold" />
                <Spinner android:id="@+id/register_grade_spinner" android:layout_width="match_parent" android:layout_height="48dp" android:entries="@array/register_grades" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/register_board" android:textColor="#334155" android:textSize="12sp" android:textStyle="bold" />
                <Spinner android:id="@+id/register_board_spinner" android:layout_width="match_parent" android:layout_height="48dp" android:entries="@array/register_boards" />
                <EditText android:id="@+id/register_country" style="@style/RegisterField" android:hint="@string/register_country" android:text="India" />
                <EditText android:id="@+id/register_state" style="@style/RegisterField" android:hint="@string/register_state" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/register_choose_session" android:textColor="#0F172A" android:textSize="16sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/register_session_detail" android:textColor="#475569" android:textSize="11sp" />
                <EditText android:id="@+id/register_date" style="@style/RegisterField" android:hint="@string/register_date" android:inputType="date" />
                <GridLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="2" android:rowCount="3" android:layout_marginTop="14dp">
                    <TextView style="@style/SessionTile" android:text="@string/register_time_6am" /><TextView style="@style/SessionTile" android:text="@string/register_time_7am" /><TextView style="@style/SessionTile" android:text="@string/register_time_6pm" /><TextView style="@style/SessionTile" android:text="@string/register_time_7pm" /><TextView style="@style/SessionTile" android:text="@string/register_time_8pm" />
                </GridLayout>
                <CheckBox android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="@string/register_consent" android:textColor="#475569" android:textSize="13sp" android:lineSpacingExtra="4dp" />
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/register_submit" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="20dp" android:background="@drawable/login_submit" android:text="@string/register_submit" android:textColor="#000000" android:textAllCaps="false" android:textSize="15sp" android:textStyle="bold" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center" android:text="@string/register_already" android:textColor="#475569" android:textSize="14sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="28dp" android:text="@string/register_about_title" android:textColor="#020617" android:textSize="24sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/register_about_body" android:textColor="#475569" android:textSize="16sp" android:lineSpacingExtra="8dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="34dp" android:text="@string/register_contact_title" android:textColor="#020617" android:textSize="24sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/register_contact_body" android:textColor="#475569" android:textSize="16sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/register_contact_details" android:textColor="#B8860B" android:textSize="16sp" android:textStyle="bold" android:lineSpacingExtra="8dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:padding="14dp" android:text="@string/register_policy" android:textColor="#475569" android:textSize="14sp" android:lineSpacingExtra="8dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
