<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/admin_login_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#FFFDF8">
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@drawable/landing_background">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="22dp" android:paddingTop="70dp" android:paddingBottom="42dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="28dp" android:background="@drawable/login_card" android:elevation="4dp">
                <ImageView android:layout_width="160dp" android:layout_height="52dp" android:src="@drawable/mathsnme_brand" android:contentDescription="@string/app_name" android:scaleType="fitCenter" />
                <ImageView android:layout_width="48dp" android:layout_height="48dp" android:layout_marginTop="38dp" android:padding="13dp" android:background="@drawable/login_badge" android:src="@drawable/login_shield" android:contentDescription="@string/login_lock_description" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/login_admin_label" android:textColor="#A47700" android:textSize="14sp" android:textStyle="bold" android:letterSpacing="0.16" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/login_admin_title" android:textColor="#020617" android:textSize="34sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/admin_login_description" android:textColor="#475569" android:textSize="17sp" android:lineSpacingExtra="5dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="38dp" android:text="@string/admin_login_username" android:textColor="#334155" android:textSize="14sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:text="@string/admin_login_name" android:textColor="#64748B" android:textSize="16sp" android:textStyle="bold" android:background="@drawable/login_card" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="@string/login_password" android:textColor="#334155" android:textSize="14sp" android:textStyle="bold" />
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/admin_login_password_layout" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" app:hintEnabled="false" app:boxBackgroundColor="#FFFFFF" app:boxStrokeColor="#DFD4B9" app:boxCornerRadiusTopStart="12dp" app:boxCornerRadiusTopEnd="12dp" app:boxCornerRadiusBottomStart="12dp" app:boxCornerRadiusBottomEnd="12dp" app:endIconMode="password_toggle" app:errorIconDrawable="@null">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/admin_login_password" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:hint="@string/login_password_hint" android:inputType="textPassword" android:imeOptions="actionDone" android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/admin_login_submit" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="30dp" android:background="@drawable/login_submit" app:backgroundTint="#D4AF37" android:text="@string/admin_login_submit" android:textColor="#000000" android:textAllCaps="false" android:textSize="16sp" android:textStyle="bold" />
                <TextView android:id="@+id/admin_login_student" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="18dp" android:gravity="center" android:text="@string/login_student_switch" android:textColor="#64748B" android:textSize="15sp" android:clickable="true" android:focusable="true" />
            </LinearLayout>
            <include layout="@layout/common_footer" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
