<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.MathsNMe" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="Theme.MathsNMe" parent="Base.Theme.MathsNMe" />
    <style name="RegisterField" parent="Widget.Material3.TextInputEditText.OutlinedBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:background">#FFFFFF</item>
        <item name="android:textColorHint">#94A3B8</item>
        <item name="android:textSize">13sp</item>
        <item name="android:paddingHorizontal">12dp</item>
    </style>
    <style name="SessionTile">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">82dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">5dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#91A4BE</item>
        <item name="android:textSize">14sp</item>
        <item name="android:background">@drawable/login_admin_pill</item>
    </style>
    <style name="AdminMetricCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">16dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">24dp</item>
        <item name="android:background">@drawable/login_card</item>
    </style>
    <style name="AdminMetricLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#64748B</item>
        <item name="android:textSize">18sp</item>
    </style>
    <style name="AdminMetricValue">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:textColor">#0F172A</item>
        <item name="android:textSize">36sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="AdminNavItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">58dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:textColor">#334155</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="AdminNavActive" parent="AdminNavItem">
        <item name="android:background">@drawable/login_submit</item>
        <item name="android:textColor">#020617</item>
    </style>
    <style name="StudentCourseCard">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">112dp</item><item name="android:layout_marginBottom">18dp</item><item name="android:gravity">center_vertical</item><item name="android:paddingHorizontal">24dp</item><item name="android:textColor">#0F172A</item><item name="android:textSize">18sp</item><item name="android:textStyle">bold</item><item name="android:lineSpacingExtra">8dp</item><item name="android:background">@drawable/login_card</item>
    </style>
    <style name="StudentCourseDisabled" parent="StudentCourseCard"><item name="android:textColor">#94A3B8</item></style>
    <style name="StudentMetricCard">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">210dp</item><item name="android:layout_marginBottom">20dp</item><item name="android:gravity">center_vertical</item><item name="android:padding">28dp</item><item name="android:textColor">#0F172A</item><item name="android:textSize">17sp</item><item name="android:textStyle">bold</item><item name="android:lineSpacingExtra">8dp</item><item name="android:background">@drawable/login_card</item>
    </style>
    <style name="StudentMetricContainer">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">236dp</item><item name="android:layout_marginBottom">24dp</item><item name="android:orientation">vertical</item><item name="android:padding">32dp</item><item name="android:background">@drawable/login_card</item>
    </style>
    <style name="StudentMetricValue"><item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item><item name="android:textColor">#020617</item><item name="android:textSize">34sp</item><item name="android:textStyle">bold</item></style>
    <style name="StudentMetricLabel"><item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item><item name="android:layout_marginTop">8dp</item><item name="android:textColor">#64748B</item><item name="android:textSize">17sp</item></style>
    <style name="StudentNavItem"><item name="android:layout_width">match_parent</item><item name="android:layout_height">68dp</item><item name="android:gravity">center_vertical</item><item name="android:paddingHorizontal">20dp</item><item name="android:textColor">#475569</item><item name="android:textSize">17sp</item><item name="android:textStyle">bold</item></style>
    <style name="StudentNavActive" parent="StudentNavItem"><item name="android:background">@drawable/login_badge</item><item name="android:textColor">#8A6500</item></style>
    <style name="StudentNavDisabled" parent="StudentNavItem"><item name="android:textColor">#94A3B8</item></style>
</resources>
